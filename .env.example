# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---- Meta Model API (Muse Spark, Muse Image) -------------------------------
# Key format: LLM|<id>|<secret>. MODEL_API_KEY is accepted too.
META_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
# MUSE_IMAGE_MODEL=muse-image-1.0

# ---- Muse Spark Open, for scoring comments ---------------------------------
# Any OpenAI-compatible host, e.g. https://inference.baseten.co/v1
# Left empty: listening uses Muse Spark (META_API_KEY), then the offline mock.
MUSE_SPARK_OPEN_URL=
MUSE_SPARK_OPEN_KEY=
# MUSE_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# ---- Meta app for Facebook, Instagram, Threads -----------------------------
# developers.facebook.com > the app > App settings > Basic. Development mode is enough.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Optional: the Facebook post metric used as reach by `channel insights` (default: newest one Meta accepts).
FB_REACH_METRIC=
# Only for Facebook Login for Business; `channel login` sends scopes otherwise.
META_LOGIN_CONFIG_ID=
# Optional: ask only for these scopes at login (comma-separated). Default: every scope the build uses.
META_LOGIN_SCOPES=
# Threads use case > Settings: the Threads app secret.
THREADS_APP_SECRET=

# ---- Hồi Sau (main brand) --------------------------------------------------
# `npm run channel -- setup <token>` fills these:
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# `npm run channel -- threads-setup <token>` fills these:
THREADS_USER_ID=
THREADS_USERNAME=
THREADS_TOKEN=
THREADS_TOKEN_EXPIRES=

# ---- Character brands (channels.yaml) --------------------------------------
# Same names with the brand as suffix; add --brand lolo to setup / threads-setup.
FB_PAGE_ID_LOLO=
FB_PAGE_TOKEN_LOLO=
IG_USER_ID_LOLO=
# THREADS_USER_ID_LOLO= THREADS_USERNAME_LOLO= THREADS_TOKEN_LOLO=
# Poppy, Pango and Uni use _POPPY, _PANGO and _UNI once their Pages exist.

# ---- Local runs ------------------------------------------------------------
# 1 = the channel CLI talks to the fake Meta in packages/channel/src/demo.ts
META_GRAPH_MOCK=
CHANNEL_DATA_DIR=data

# Public HTTPS base for relative mediaUrls in episode posts (npm run site -- add <episode>).
MEDIA_BASE_URL=https://hoisau.dangtrantai.com/media/

# Dashboard login. Required when it runs anywhere but localhost (npm run cloud -- admin).
# DASHBOARD_PASSWORD=
