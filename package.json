{
  "name": "hoi-sau",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "An AI office-comedy comic whose next episode comes from the comments",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm test --workspaces --if-present",
    "studio": "tsc -b && node packages/studio/dist/cli.js",
    "story": "tsc -b && node packages/story/dist/cli.js",
    "channel": "tsc -b && node packages/channel/dist/cli.js",
    "dashboard": "tsc -b && node packages/dashboard/dist/cli.js",
    "site": "node scripts/site.mjs",
    "cloud": "node scripts/cloud.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "typescript": "^5.6.0"
  }
}
